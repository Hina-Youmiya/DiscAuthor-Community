 int main(int argc, char** argv)
 {
+    // DiscAuthor: package an authored BDMV tree without remuxing its menus.
+    if (argc == 5 && std::string(argv[1]) == "--pack-iso") {
+        try {
+            namespace fs = std::filesystem;
+            fs::path root(argv[2]);
+            uint64_t total = 0;
+            for (auto& e : fs::recursive_directory_iterator(root))
+                if(e.is_regular_file() && e.path().filename().string().rfind("._",0)!=0) total += e.file_size();
+            uint64_t completed = 0, lastReported = 0;
+            auto lastReportTime = std::chrono::steady_clock::now();
+            // Report copied payload, not elapsed time or a preallocated ISO size.
+            // Keep completion pending until the metadata and fsync also succeed.
+            const auto reportProgress = [&]() {
+                const double percent = total ? 100.0 * completed / total : 0.0;
+                std::cout << std::fixed << std::setprecision(3)
+                          << std::min(99.9, percent) << "% complete" << std::endl;
+                lastReported = completed;
+                lastReportTime = std::chrono::steady_clock::now();
+            };
+            reportProgress();
+            IsoWriter iso(IsoHeaderData::reproducible());
+            iso.setVolumeLabel(argv[4]);
+            if (!iso.open(argv[3], total + 64*1024*1024, 256)) return 2;
+            std::vector<fs::path> paths;
+            for (auto& e : fs::recursive_directory_iterator(root))
+                if(e.path().filename().string().rfind("._",0)!=0) paths.push_back(e.path());
+            std::sort(paths.begin(), paths.end());
+            // Keep HDD reads and writes in bounded batches. Small alternating
+            // reads/writes compete badly with other readers of the same drive.
+            std::vector<char> inputBuffer(4 * 1024 * 1024);
+            std::vector<char> copyBuffer(4 * 1024 * 1024);
+            for (auto& path : paths) {
+                std::string rel = fs::relative(path,root).generic_string();
+                if (fs::is_directory(path)) { iso.createDir(rel); continue; }
+                std::unique_ptr<ISOFile> out(iso.createFile());
+                if(!out->open(rel.c_str(), 0)) throw std::runtime_error("ISO file open failed");
+                const uint64_t expected = fs::file_size(path);
+                std::ifstream in;
+                // libc++ requires the file buffer to be configured before open.
+                in.rdbuf()->pubsetbuf(inputBuffer.data(), inputBuffer.size());
+                in.open(path, std::ios::binary);
+                if (!in.is_open()) throw std::runtime_error("ISO input open failed: " + path.string());
+                uint64_t copied = 0;
+                while (in) {
+                    in.read(copyBuffer.data(), copyBuffer.size());
+                    const auto n = in.gcount();
+                    if (n && out->write(copyBuffer.data(), n) != n) throw std::runtime_error("ISO write failed");
+                    copied += n;
+                    completed += n;
+                    const auto elapsed = std::chrono::steady_clock::now() - lastReportTime;
+                    if (completed - lastReported >= 8 * 1024 * 1024 || elapsed >= std::chrono::milliseconds(500))
+                        reportProgress();
+                }
+                if (in.bad() || !in.eof() || copied != expected || fs::file_size(path) != expected)
+                    throw std::runtime_error("ISO input read failed or changed: " + path.string());
+                if (!out->close()) throw std::runtime_error("ISO input close failed: " + path.string());
+            }
+            reportProgress();
+            iso.close();
+            std::cout << "100.000% complete" << std::endl;
+            return 0;
+        } catch(const std::exception& e) { std::cerr << e.what() << std::endl; return 2; }
+    }
+
